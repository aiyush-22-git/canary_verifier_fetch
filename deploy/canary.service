[Unit]
Description=Canary trust auditor (one Bureau, eight agents)
After=network-online.target
Wants=network-online.target
# Never run two copies: the same seeds on two machines share one Agentverse address.

[Service]
User=canary
Group=canary
WorkingDirectory=/opt/canary
# .env (keys and seeds) is read from /opt/canary/.env by core/config.py; only the DB path is set here.
Environment=CANARY_DB=/var/lib/canary/canary.db
# asi1 token-budget counter survives restarts and redeploys here. Raise LLM_TOKEN_CAP in .env if a demo day needs more than 1M tokens.
Environment=LLM_USAGE_FILE=/var/lib/canary/asi1_usage.json
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/canary/.venv/bin/python run.py
Restart=always
RestartSec=5
# A clean stop gives the Bureau time to mark the agents inactive on Agentverse.
TimeoutStopSec=70
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/canary /opt/canary

[Install]
WantedBy=multi-user.target
