# --- Mode ---
# 1 = dev seeds, no mailbox, no Agentverse registration. Codex machines and CI always use this.
LOCAL_ONLY=1

# --- asi1 (Orchestrator intent + planner, Judge grading) ---
ASI1_API_KEY=
# ASI1_MODEL=asi1
# ASI1_FALLBACK_MODEL=asi1-mini
# ASI1_TARGET_MODEL=asi1-mini   # demo targets' brain
# LLM_TOKEN_CAP=1000000         # total asi1 tokens across every call, persisted in LLM_USAGE_FILE (raise it for demo day)

# --- Agentverse (real run only; one machine) ---
AGENTVERSE_API_KEY=
AGENT_NETWORK=testnet
# One secret seed per agent. Never share a seed between two machines: they would share an address.
SEED_ORCHESTRATOR=
SEED_JUDGE=
SEED_PROBE_INJECTION=
SEED_PROBE_LEAK=
SEED_PROBE_PAYMENT=
SEED_TARGET_LEAKY=
SEED_TARGET_OVERCHARGER=
SEED_TARGET_SOLID=

# --- Payment rail for paid audits: dodo | fet | stripe ---
PAYMENT_RAIL=dodo
AUDIT_PRICE_USD=1.00

# Dodo Payments (hosted checkout link + Canary's own server-side check). Create one product in the Dodo
# dashboard (test mode) priced at or above AUDIT_PRICE_USD, then paste its id here.
DODO_PAYMENTS_API_KEY=
DODO_PRODUCT_ID=
DODO_ENV=test_mode
# DODO_RETURN_URL=https://example.com/thanks
# DODO_SEND_REQUESTPAYMENT=0   # 1 = also offer a Payment Protocol RequestPayment to agent buyers

# Alternatives
# AUDIT_PRICE_FET=0.001
# FET_USE_TESTNET=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Tuning ---
# CANARY_PORT_BASE=8100   # agents use BASE..BASE+7; change it if the ports are taken
# PROBE_TIMEOUT_S=15
# AUDIT_TIMEOUT_S=80
# REVERIFY_INTERVAL_S=600
# CANARY_DB=canary.db
